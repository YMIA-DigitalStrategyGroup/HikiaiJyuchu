    "SourceTableSchema": "",
    "CreateViewSql": "select `d`.`JUCHU_NBR` AS `JUCHU_NBR`,`d`.`EDABAN` AS `EDABAN`,`j`.`KANRI_NBR` AS `KANRI_NBR`,`s`.`KENMEI` AS `KENMEI`,`d`.`MEISAI_NBR` AS `MEISAI_SEQ_NBR`,`d`.`KOJI_KUBUN` AS `KOJI_KUBUN`,`d`.`KOJI_KUBUN` AS `KUBUN`,`d`.`HINBAN` AS `HINBAN`,`d`.`HINMEI` AS `HINMEI`,`d`.`SURYO` AS `SURYO`,`d`.`TANI_CODE` AS `TANI`,`d`.`HANBAI_TANKA` AS `TANKA`,`d`.`HANBAI_KINGAKU` AS `KINGAKU`,`j`.`MARGIN_FLAG` AS `MARGIN_FLAG`,`j`.`MARGIN_RITSU1` AS `MARGIN_RITSU1`,`j`.`MARGIN_RITSU2` AS `MARGIN_RITSU2`,`j`.`MARGIN_RITSU3` AS `MARGIN_RITSU3`,`opt`.`TANKA_OROSHI` AS `TANKA_OROSHI`,(case when (`opt`.`HINBAN` is not null) then `opt`.`TANKA_OROSHI` when (`j`.`MARGIN_FLAG` = 3) then (ceiling((((round((`d`.`HANBAI_KINGAKU` * (1 + (`j`.`MARGIN_RITSU1` / 100.0))),2) * round((1 + (`j`.`MARGIN_RITSU2` / 100.0)),2)) * (1 + (`j`.`MARGIN_RITSU3` / 100.0))) / 1000.0)) * 1000) when (`j`.`MARGIN_FLAG` = 2) then (ceiling(((round((`d`.`HANBAI_KINGAKU` * (1 + (`j`.`MARGIN_RITSU1` / 100.0))),2) * (1 + (`j`.`MARGIN_RITSU2` / 100.0))) / 100.0)) * 100) when (`j`.`MARGIN_FLAG` = 1) then (ceiling(((`d`.`HANBAI_KINGAKU` * (1 + (`j`.`MARGIN_RITSU1` / 100.0))) / 100.0)) * 100) else `d`.`HANBAI_KINGAKU` end) AS `MARGIN_KOMI_KINGAKU`,`d`.`BIKO` AS `BIKO` from (((`tjuchum` `d` join `tjuchu` `j` on((`d`.`JUCHU_NBR` = `j`.`JUCHU_NBR`))) left join `tshodan` `s` on((`j`.`KANRI_NBR` = `s`.`KANRI_NBR`))) left join `moption_futai_koji` `opt` on(((`d`.`HINBAN` = `opt`.`HINBAN`) and (`j`.`KISHU` = `opt`.`KISHU`))))",
